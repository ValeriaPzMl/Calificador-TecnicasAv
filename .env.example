# Copia este archivo como .env y llénalo con los datos de tu proyecto de
# Supabase. El .env NO se sube a git (tiene la contraseña de la BD).
# Sin .env, todo funciona en local con SQLite (data/calificador.db).

# Connect → Session pooler. Si la contraseña tiene @ : / ? #, escríbela
# codificada (@ = %40) o usa una sin esos caracteres.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Project Settings → API Keys (estas dos sí pueden verse en la página)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo si tu proyecto usa la llave JWT "legacy" (HS256):
# Project Settings → JWT Keys → Legacy JWT secret
# SUPABASE_JWT_SECRET=

# Usuario dueño de lo que se crea desde los comandos (cli.exams, cli.grade...):
# su uuid de Authentication → Users
# CALIFICADOR_OWNER_ID=
